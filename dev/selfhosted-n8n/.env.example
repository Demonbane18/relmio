# Copy this file to .env, replace every placeholder, then chmod 600 .env.
NGROK_AUTHTOKEN=replace-with-dedicated-ngrok-authtoken
NGROK_DOMAIN=replace-this-with-your-domain.ngrok.app
NGROK_BASIC_AUTH_USER=replace-with-a-basic-auth-username
NGROK_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password
N8N_ENCRYPTION_KEY=replace-with-64-lowercase-hex-characters
N8N_LOCAL_PORT=5678
NGROK_INSPECTOR_PORT=4040
GENERIC_TIMEZONE=Asia/Manila
RELMIO_TEST_ASSISTANT_MODE=disabled
RELMIO_TEST_PRIVILEGED_SANDBOX_CONFIRMATION=not-confirmed
RELMIO_TEST_PUBLIC_CONFIRMATION=replace-with-EXPOSE_DISPOSABLE_N8N-when-ready
