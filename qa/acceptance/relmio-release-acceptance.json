{
  "name": "Relmio release acceptance",
  "nodes": [
    {
      "parameters": {},
      "id": "00000000-0000-4000-8000-000000000001",
      "name": "Run acceptance",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        600
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "00000000-0000-4000-8000-000000000002",
              "name": "model",
              "value": "gpt-6-astra",
              "type": "string"
            },
            {
              "id": "00000000-0000-4000-8000-000000000003",
              "name": "localModel",
              "value": "qwen3:0.6b",
              "type": "string"
            },
            {
              "id": "00000000-0000-4000-8000-000000000020",
              "name": "sidecarBaseUrl",
              "value": "http://n8n-openai-oauth:10531/v1",
              "type": "string"
            },
            {
              "id": "00000000-0000-4000-8000-000000000021",
              "name": "acceptanceVersion",
              "value": "2026-10-07.3",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000004",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        600
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.sidecarBaseUrl.replace(/\\/+$/, '') }}/responses",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Settings').first().json.model, input: [{ role: 'user', content: 'Reply with exactly: http responses ok' }] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "00000000-0000-4000-8000-000000000005",
      "name": "HTTP Request: Responses",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "credentials": {
        "openAiApi": {
          "name": "OpenAI Relmio"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.sidecarBaseUrl.replace(/\\/+$/, '') }}/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Settings').first().json.model, messages: [{ role: 'user', content: 'Reply with exactly: http chat ok' }] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "00000000-0000-4000-8000-000000000006",
      "name": "HTTP Request: Chat Completions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        200
      ],
      "credentials": {
        "openAiApi": {
          "name": "OpenAI Relmio"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Use the calculator tool to work out 17 * 23, then reply with only the number.",
        "options": {
          "returnIntermediateSteps": true
        }
      },
      "id": "00000000-0000-4000-8000-000000000007",
